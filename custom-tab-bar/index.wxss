.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  width: 100vw;
  min-height: calc(136rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 18rpx 0 calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  background: rgba(255, 253, 246, 0.98);
  border-top: 1rpx solid rgba(16, 34, 74, 0.08);
  box-shadow: 0 -14rpx 36rpx rgba(35, 39, 55, 0.12);
  -webkit-backdrop-filter: blur(18rpx) saturate(1.04);
  backdrop-filter: blur(18rpx) saturate(1.04);
  overflow: visible;
  transform: translateZ(0);
}

.tab-item {
  flex: 1;
  min-width: 0;
  min-height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  color: rgba(49, 64, 95, 0.52);
}

.tab-mark {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: inherit;
  background: transparent;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.66;
}

.tab-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 650;
}

.tab-item.active {
  color: #10224A;
}

.tab-item.active .tab-mark {
  color: #2F6FAE;
  background: #E8EEFF;
}

.tab-item.active .tab-icon {
  opacity: 1;
}

.tab-item.active::after {
  content: '';
  width: 8rpx;
  height: 8rpx;
  margin-top: 7rpx;
  border-radius: 50%;
  background: #2F6FAE;
}
