.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(16, 34, 74, 0.08);
  border-radius: 999rpx;
  color: #31405F;
  font-size: 22rpx;
  line-height: 1;
  background: #F6F3E8;
}

.chip.active {
  color: #10224A;
  border-color: rgba(47, 111, 174, 0.22);
  background: #E8EEFF;
}

.chip.light {
  color: #31405F;
  border-color: rgba(16, 34, 74, 0.08);
  background: #F6F3E8;
}

.chip.light.active {
  color: #10224A;
  border-color: rgba(245, 154, 35, 0.24);
  background: #FFE8BF;
}
