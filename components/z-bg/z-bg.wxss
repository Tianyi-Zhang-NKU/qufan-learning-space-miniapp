:host {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

.z-bg {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background: #E9E6DA;
}

.z-bg-image {
  width: 100%;
  height: 100%;
  opacity: 0.18;
}

.z-bg-wash {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(236, 232, 221, 0.84), rgba(233, 230, 218, 0.96)),
    rgba(255, 253, 246, 0.56);
}
