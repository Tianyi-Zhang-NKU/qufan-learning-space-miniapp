.qf-role-tabbar {
  position: fixed !important;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  width: 100vw;
  min-height: calc(136rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 18rpx 0 calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  background: rgba(255, 253, 246, 0.98);
  border-top: 1rpx solid rgba(16, 34, 74, 0.08);
  box-shadow: 0 -14rpx 36rpx rgba(35, 39, 55, 0.12);
  -webkit-backdrop-filter: blur(18rpx) saturate(1.04);
  backdrop-filter: blur(18rpx) saturate(1.04);
  overflow: visible;
  transform: translateZ(0);
}

.qf-role-tabbar.inline {
  position: relative !important;
  left: auto !important;
  right: auto !important;
  bottom: auto !important;
  z-index: 1;
  width: 100vw;
  flex-shrink: 0;
  margin: 16rpx 0 0;
  left: 50% !important;
  transform: translateX(-50%);
}

.qf-role-tab {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  color: rgba(49, 64, 95, 0.52);
  transition: color 180ms ease, transform 180ms ease;
}

.qf-role-mark {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: inherit;
  background: transparent;
  transition: transform 180ms ease, color 180ms ease, background 180ms ease;
}

.qf-role-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.66;
}

.qf-role-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1;
  color: inherit;
  font-weight: 650;
}

.qf-role-tab.active {
  color: #10224A;
}

.qf-role-tab.active .qf-role-mark {
  color: #2F6FAE;
  background: #E8EEFF;
}

.qf-role-tab.active .qf-role-icon {
  opacity: 1;
}

.qf-role-tab.active::after {
  content: '';
  width: 8rpx;
  height: 8rpx;
  margin-top: 7rpx;
  border-radius: 50%;
  background: #2F6FAE;
}

.qf-role-tab:active {
  transform: translateY(2rpx);
}
