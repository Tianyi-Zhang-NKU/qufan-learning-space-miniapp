.status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #3E8B68;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  background: #EEF5DD;
}

.status.warn {
  color: #9A5B10;
  background: #FFE8BF;
}

.status.muted {
  color: #8A8D88;
  border: 1rpx solid rgba(16, 34, 74, 0.08);
  background: #F6F3E8;
}

.status.danger {
  color: #A33A3A;
  background: rgba(255, 232, 224, 0.86);
}
