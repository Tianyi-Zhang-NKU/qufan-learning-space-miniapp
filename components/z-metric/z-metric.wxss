.metric {
  display: block;
  min-height: 144rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid rgba(16, 34, 74, 0.08);
  border-radius: 24rpx;
  color: #10224A;
  background: #FFFDF6;
  box-shadow: 0 14rpx 34rpx rgba(35, 39, 55, 0.08);
}

.metric.compact,
.metric.mini {
  min-height: 126rpx;
  padding: 20rpx 16rpx;
}

.metric-value {
  display: block;
  color: #10224A;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 800;
}

.metric.compact .metric-value,
.metric.mini .metric-value {
  font-size: 36rpx;
}

.metric-label {
  display: block;
  margin-top: 14rpx;
  color: #8A8D88;
  font-size: 22rpx;
  line-height: 1.3;
}
