.content-area {
  max-width: 620rpx;
  margin: 0 auto;
}

.quiz-options {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.quiz-option-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 38rpx 34rpx;
}

.quiz-option-icon {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  border-radius: 22rpx;
  background: rgba(249, 115, 22, 0.08);
}

.quiz-option-img {
  width: 46rpx;
  height: 46rpx;
}

.quiz-option-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.quiz-option-title {
  color: #173a32;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.quiz-option-desc {
  margin-top: 8rpx;
  color: rgba(45, 75, 64, 0.58);
  font-size: 23rpx;
  line-height: 1.4;
}

.quiz-option-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.quiz-option-count {
  color: #f97316;
  font-size: 22rpx;
  font-weight: 600;
}

.quiz-option-count.muted {
  color: rgba(45, 75, 64, 0.42);
  font-weight: 400;
}

.quiz-option-arrow {
  color: rgba(45, 75, 64, 0.3);
  font-size: 40rpx;
  font-weight: 300;
}
