/* ================================================================
   Exercises / 反馈 Page — 本讲反馈 + 课堂小测/本讲总结
   ================================================================ */

/* ---- Shared layout ---- */
.content-area {
  max-width: 620rpx;
  margin: 0 auto;
}

/* ---- Shared meta row ---- */
.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}

.meta-row + .meta-row {
  border-top: 1rpx solid rgba(83, 117, 91, 0.08);
}

.meta-icon {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
}


.meta-status {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1;
}

.meta-status.finished {
  color: #14532d;
  background: rgba(187, 247, 208, 0.72);
}

.meta-status.pending {
  color: #8A5A00;
  background: rgba(255, 232, 191, 0.82);
}
.meta-text {
  flex: 1;
  min-width: 0;
  color: #173a32;
  font-size: 24rpx;
  font-weight: 600;
}

/* ---- Shared empty ---- */
.records-empty {
  padding: 28rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx dashed rgba(83, 117, 91, 0.16);
  background: rgba(255, 255, 255, 0.32);
  text-align: center;
}

.records-empty > text {
  display: block;
  color: rgba(45, 75, 64, 0.42);
  font-size: 23rpx;
  line-height: 1.5;
}

/* ---- Shared tag ---- */
.detail-tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.detail-tag.ok {
  color: #14532d;
  border: 1rpx solid rgba(22, 163, 74, 0.18);
  background: rgba(187, 247, 208, 0.5);
}

.detail-tag.muted {
  color: #506157;
  border: 1rpx solid rgba(83, 117, 91, 0.14);
  background: rgba(226, 232, 222, 0.5);
}

/* ================================================================
   Mode 1: Course List — 反馈首页
   ================================================================ */

.course-entry-card {
  margin-bottom: 30rpx;
  padding: 34rpx 32rpx;
}

.course-entry-header {
  margin-bottom: 22rpx;
}

.course-entry-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.course-entry-name {
  font-size: 33rpx;
  font-weight: 700;
  color: #173a32;
  line-height: 1.25;
}

.course-entry-grade {
  display: block;
  margin-top: 8rpx;
  color: rgba(45, 75, 64, 0.58);
  font-size: 23rpx;
}

.course-entry-meta {
  margin-bottom: 20rpx;
  padding: 16rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.44);
  border: 1rpx solid rgba(83, 117, 91, 0.1);
}

.course-entry-sessions {
  margin-bottom: 20rpx;
}

.session-preview-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
}

.session-preview-item + .session-preview-item {
  border-top: 1rpx solid rgba(83, 117, 91, 0.08);
}

.session-preview-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #f97316;
  box-shadow: 0 0 0 4rpx rgba(249, 115, 22, 0.14);
}

.session-preview-label {
  flex: 1;
  min-width: 0;
  color: #173a32;
  font-size: 24rpx;
  font-weight: 600;
}

.session-preview-date {
  flex-shrink: 0;
  color: rgba(45, 75, 64, 0.5);
  font-size: 21rpx;
}

.session-preview-count {
  flex-shrink: 0;
  color: rgba(45, 75, 64, 0.42);
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(83, 117, 91, 0.06);
}

.session-preview-count.has-records {
  color: #14532d;
  background: rgba(187, 247, 208, 0.44);
}

.course-entry-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(83, 117, 91, 0.1);
}

.course-entry-total {
  color: #f97316;
  font-size: 23rpx;
  font-weight: 600;
}

.course-entry-total.muted {
  color: rgba(45, 75, 64, 0.42);
  font-weight: 400;
}

.course-entry-arrow {
  color: rgba(45, 75, 64, 0.3);
  font-size: 36rpx;
  font-weight: 300;
}

/* ================================================================
   Mode 2: Session List — 课次列表（可点击）
   ================================================================ */

.session-entry-card {
  margin-bottom: 30rpx;
  padding: 34rpx 32rpx;
}

.session-entry-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.session-entry-index {
  font-size: 30rpx;
  font-weight: 700;
  color: #173a32;
}

.session-entry-badge {
  font-size: 21rpx;
  color: #fff9ec;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #f97316, #ea580c);
  font-weight: 600;
}

.session-entry-title {
  display: block;
  color: rgba(45, 75, 64, 0.64);
  font-size: 24rpx;
  margin-bottom: 18rpx;
}

.session-entry-meta {
  margin-bottom: 18rpx;
  padding: 16rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.44);
  border: 1rpx solid rgba(83, 117, 91, 0.1);
}

.session-entry-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(83, 117, 91, 0.1);
}

.session-entry-count {
  color: rgba(45, 75, 64, 0.42);
  font-size: 23rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(83, 117, 91, 0.06);
}

.session-entry-count.has-records {
  color: #f97316;
  font-weight: 600;
  background: rgba(249, 115, 22, 0.1);
}

.session-entry-arrow {
  color: rgba(45, 75, 64, 0.3);
  font-size: 36rpx;
  font-weight: 300;
}

/* ================================================================
   Mode 3: Single-session Records — 仅本次课错题
   ================================================================ */

.session-info-card {
  margin-bottom: 8rpx;
  padding: 30rpx 32rpx;
}

.session-info-title {
  display: block;
  color: #173a32;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.session-info-rows {
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.44);
  border: 1rpx solid rgba(83, 117, 91, 0.1);
}

/* Records list — single session only */
.records-single-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-detail-card {
  margin-bottom: 0;
  padding: 28rpx 30rpx;
}

.record-detail-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.record-detail-date {
  color: rgba(45, 75, 64, 0.5);
  font-size: 21rpx;
}

.record-detail-teacher {
  color: rgba(45, 75, 64, 0.6);
  font-size: 21rpx;
  font-weight: 600;
}

.record-detail-text {
  display: block;
  color: #1f352e;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.record-detail-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}

.record-detail-tags .detail-tag {
  color: rgba(45, 75, 64, 0.62);
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(83, 117, 91, 0.12);
  background: rgba(255, 255, 255, 0.44);
}

.record-detail-media {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.media-btn {
  min-height: 60rpx;
  font-size: 22rpx;
}

/* ================================================================
   Mode 5: All Records — 我的错题本
   ================================================================ */

.all-course-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 36rpx 0 20rpx;
}

.all-course-header:first-child {
  margin-top: 8rpx;
}

.all-course-name {
  flex-shrink: 0;
  color: #fff9ec;
  font-size: 28rpx;
  font-weight: 700;
}

.all-course-divider {
  flex: 1;
  height: 1rpx;
  background: rgba(255, 249, 236, 0.16);
}

.all-session-card {
  margin-bottom: 22rpx;
  padding: 28rpx 30rpx;
}

.all-session-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(83, 117, 91, 0.12);
}

.all-session-title {
  color: #173a32;
  font-size: 26rpx;
  font-weight: 700;
}

.all-session-count {
  color: #f97316;
  font-size: 21rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(249, 115, 22, 0.1);
}

.all-records-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.all-record-item {
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(83, 117, 91, 0.1);
  background: rgba(255, 255, 255, 0.4);
}

.all-record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.all-record-date {
  color: rgba(45, 75, 64, 0.5);
  font-size: 21rpx;
}

.all-record-teacher {
  color: rgba(45, 75, 64, 0.6);
  font-size: 21rpx;
  font-weight: 600;
}

.all-record-text {
  display: block;
  color: #1f352e;
  font-size: 25rpx;
  line-height: 1.55;
  margin-bottom: 8rpx;
}

.all-record-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.all-record-media {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

/* ================================================================
   Mode 4: Test List — 课堂小测 / 本讲总结
   ================================================================ */

/* Session tabs scrollable bar */
.session-tabs-scroll {
  width: 100%;
  margin-bottom: 28rpx;
  white-space: nowrap;
}

.session-tabs {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 4rpx;
}

.session-tab {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
  border: 1rpx solid rgba(83, 117, 91, 0.16);
}

.session-tab.active {
  background: linear-gradient(145deg, #f97316, #ea580c);
  border-color: transparent;
  box-shadow: 0 12rpx 28rpx rgba(234, 88, 12, 0.32);
}

.session-tab-text {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(45, 75, 64, 0.7);
  white-space: nowrap;
}

.session-tab.active .session-tab-text {
  color: #fff9ec;
}

.test-session-card {
  margin-bottom: 30rpx;
  padding: 34rpx 32rpx;
}

.test-session-header {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(83, 117, 91, 0.14);
}

.test-session-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.test-session-index {
  font-size: 30rpx;
  font-weight: 700;
  color: #173a32;
}

.test-session-label {
  font-size: 21rpx;
  color: #fff9ec;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #f97316, #ea580c);
  font-weight: 600;
}

.test-session-name {
  display: block;
  color: rgba(45, 75, 64, 0.64);
  font-size: 24rpx;
}

.test-session-info {
  margin-bottom: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.44);
  border: 1rpx solid rgba(83, 117, 91, 0.1);
}

.test-records {
  margin-top: 6rpx;
}

.test-records-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.test-record-item {
  position: relative;
  overflow: hidden;
  padding: 24rpx 26rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(234, 88, 12, 0.16);
  background:
    linear-gradient(145deg, rgba(255, 237, 213, 0.52), rgba(255, 255, 255, 0.38)),
    rgba(255, 247, 232, 0.44);
}

.pass-stamp {
  position: absolute;
  top: 16rpx;
  right: -20rpx;
  padding: 6rpx 40rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #dc2626;
  border: 4rpx solid #dc2626;
  border-radius: 8rpx;
  transform: rotate(15deg);
  opacity: 0.85;
  letter-spacing: 4rpx;
  pointer-events: none;
}

.test-record-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.test-record-title {
  color: #173a32;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.3;
}

.test-record-meta {
  margin-top: 6rpx;
  color: rgba(45, 75, 64, 0.56);
  font-size: 21rpx;
}

.feedback-type-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.type-card {
  min-width: 0;
  min-height: 112rpx;
  padding: 14rpx 8rpx;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  border: 1rpx solid rgba(83, 117, 91, 0.14);
  background: rgba(240, 243, 221, 0.72);
}

.type-card:active {
  transform: scale(0.98);
}

.type-icon {
  width: 38rpx;
  height: 38rpx;
}

.type-title {
  color: #173a32;
  font-size: 21rpx;
  font-weight: 750;
  line-height: 1.15;
}

.type-count {
  color: rgba(45, 75, 64, 0.58);
  font-size: 19rpx;
  line-height: 1.1;
}

.test-record-text {
  display: block;
  color: #1f352e;
  font-size: 26rpx;
  line-height: 1.6;
}

.test-record-text.collapsed {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.test-record-text-wrap {
  margin-bottom: 8rpx;
}

.test-record-expand {
  display: inline-block;
  margin-top: 8rpx;
  color: #f97316;
  font-size: 22rpx;
  font-weight: 600;
}

.test-record-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.test-record-arrow {
  color: rgba(45, 75, 64, 0.34);
  font-size: 32rpx;
  font-weight: 300;
}

.test-record-media {
  width: 100%;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(83, 117, 91, 0.08);
}

/* Inline media styles for test records */
.test-record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.test-inline-images {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.test-inline-img {
  width: 100%;
  max-width: 100%;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.5);
}

.test-inline-videos {
  margin-top: 16rpx;
}

.test-inline-video {
  width: 100%;
  border-radius: 14rpx;
  margin-bottom: 14rpx;
}

.test-inline-voices {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.test-voice-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, rgba(79, 140, 108, 0.1), rgba(45, 90, 63, 0.06));
  border: 1rpx solid rgba(83, 117, 91, 0.16);
}

.test-voice-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
}

.test-voice-text {
  color: #2d5a3f;
  font-size: 24rpx;
  font-weight: 600;
}

.workbook-export-card {
  margin: 20rpx 0 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 8rpx;
  background: #FFFDF6;
  border: 1rpx solid rgba(16, 34, 74, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
}

.workbook-export-copy {
  flex: 1 0 100%;
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.workbook-export-title {
  color: #10224A;
  font-size: 30rpx;
  font-weight: 800;
}

.workbook-export-sub {
  color: #617064;
  font-size: 24rpx;
}

.workbook-export-btn {
  margin: 0;
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 8rpx;
  background: #10224A;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.workbook-export-actions {
  display: flex;
  width: 100%;
  gap: 12rpx;
}

.workbook-export-btn.secondary {
  background: #1f7a4d;
}

.workbook-record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin: 0 0 28rpx;
}

.workbook-record-card {
  padding: 22rpx 24rpx;
  border-radius: 8rpx;
  background: rgba(255, 253, 246, 0.92);
  border: 1rpx solid rgba(16, 34, 74, 0.1);
}

.workbook-record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(16, 34, 74, 0.08);
}

.workbook-record-title-block {
  flex: 1;
  min-width: 0;
}

.workbook-record-title {
  display: block;
  color: #10224A;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
}

.workbook-record-meta {
  display: block;
  margin-top: 6rpx;
  color: #617064;
  font-size: 22rpx;
  line-height: 1.35;
}

.workbook-record-badges {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.workbook-badge {
  max-width: 220rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #10224A;
  font-size: 21rpx;
  font-weight: 700;
  background: #FFE8BF;
}

.workbook-badge.muted {
  color: #1f7a4d;
  background: #EEF5DD;
}

.workbook-question-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.workbook-question-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 72rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: #F6F3E8;
}

.workbook-question-order {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  background: #2F6FAE;
}

.workbook-question-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.workbook-question-title {
  color: #10224A;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.35;
}

.workbook-question-file {
  color: #8A8D88;
  font-size: 21rpx;
  line-height: 1.3;
}

.workbook-question-file-btn {
  flex-shrink: 0;
  margin: 0;
  min-width: 74rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 8rpx;
  color: #10224A;
  font-size: 22rpx;
  font-weight: 700;
  background: #E8EEFF;
}
