<view class="qf-page qf-page-fixed admin-grants-page">
  <z-bg mode="dark"></z-bg>
  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="qf-scroll-body">
    <view class="qf-top">
      <view class="qf-brand">
        <text class="qf-brand-title">管理员授权</text>
        <text class="qf-brand-sub">手机号是唯一识别，授权范围按年级和学科生效</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="qf-empty">正在加载授权范围</view>
    <block wx:else>
      <view class="qf-section">新增或更新授权</view>
      <view class="qf-card grant-editor">
        <view class="grant-field">
          <text class="grant-label">授权手机号</text>
          <input class="grant-input" type="number" maxlength="11" value="{{phone}}" placeholder="输入教师或教务手机号" bindinput="onPhoneInput" />
        </view>
        <view class="grant-field">
          <text class="grant-label">可管理年级</text>
          <view class="scope-grid">
            <button wx:for="{{gradeOptions}}" wx:key="*this" class="scope-option {{selectedGrades.indexOf(item) >= 0 ? 'active' : ''}}" data-value="{{item}}" bindtap="toggleGradeScope">{{item}}</button>
          </view>
        </view>
        <view class="grant-field">
          <text class="grant-label">可管理学科</text>
          <view class="scope-grid">
            <button wx:for="{{subjectOptions}}" wx:key="*this" class="scope-option {{selectedSubjects.indexOf(item) >= 0 ? 'active' : ''}}" data-value="{{item}}" bindtap="toggleSubjectScope">{{item}}</button>
          </view>
        </view>
        <button class="qf-btn full grant-save" disabled="{{saving}}" bindtap="saveGrant">{{saving ? '保存中' : '保存授权'}}</button>
      </view>

      <view class="qf-section">已授权管理员</view>
      <view wx:if="{{grants.length}}" class="grant-list">
        <view wx:for="{{grants}}" wx:key="id" class="qf-card grant-card">
          <view class="grant-card-head">
            <view>
              <text class="grant-name">{{item.displayName || item.phone}}</text>
              <text class="grant-phone">{{item.phone}}</text>
            </view>
            <view class="grant-status {{item.fullAccess ? 'full' : ''}}">{{item.fullAccess ? '超级管理员' : '分级管理员'}}</view>
          </view>
          <view wx:if="{{item.fullAccess}}" class="grant-all-scope">可管理全部年级和学科</view>
          <view wx:else class="grant-scope-lines">
            <text>年级：{{item.gradeScopes.join('、') || '全部'}}</text>
            <text>学科：{{item.subjectScopes.join('、') || '全部'}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="qf-empty compact">尚未配置分级管理员</view>
    </block>
    <view class="qf-safe-bottom"></view>
  </scroll-view>
  <qf-role-tabbar role="admin" is-super-admin="{{isSuperAdmin}}" current="/pages/admin/manage/manage" fixed="{{false}}"></qf-role-tabbar>
</view>
