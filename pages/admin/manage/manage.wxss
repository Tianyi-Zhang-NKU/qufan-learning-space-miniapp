.grant-editor,
.grant-card {
  border-radius: 8rpx;
}

.grant-editor {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.grant-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.grant-label,
.grant-name {
  color: #10224A;
  font-size: 25rpx;
  font-weight: 750;
}

.grant-input {
  min-height: 78rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(16, 34, 74, 0.12);
  border-radius: 6rpx;
  color: #10224A;
  font-size: 26rpx;
  background: #FFFCF2;
}

.scope-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.scope-option {
  min-width: 112rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid rgba(16, 34, 74, 0.12);
  border-radius: 5rpx;
  color: #53627B;
  font-size: 22rpx;
  line-height: 58rpx;
  background: #FFFDF6;
}

.scope-option.active {
  border-color: #2F6FAE;
  color: #FFFFFF;
  background: #2F6FAE;
}

.grant-save {
  min-height: 82rpx;
}

.grant-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.grant-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.grant-phone,
.grant-scope-lines,
.grant-all-scope {
  display: block;
  color: #69758B;
  font-size: 22rpx;
  line-height: 1.55;
}

.grant-status {
  padding: 7rpx 12rpx;
  color: #4E6D42;
  font-size: 20rpx;
  font-weight: 750;
  background: #E4F1DA;
}

.grant-status.full {
  color: #3F5D8D;
  background: #E8EEFF;
}

.grant-scope-lines,
.grant-all-scope {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(16, 34, 74, 0.08);
}
