.admin-dashboard {
  color: #10224A;
}

.summary-strip {
  display: flex;
  min-height: 184rpx;
  margin: 0 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(16, 34, 74, 0.1);
  border-radius: 8rpx;
  background: #FFFDF6;
  box-shadow: 0 16rpx 38rpx rgba(35, 39, 55, 0.09);
}

.summary-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding: 28rpx;
}

.summary-kicker,
.summary-meta,
.analytics-meta,
.subject-meta,
.focus-meta,
.grant-meta {
  color: #8A8D88;
  font-size: 21rpx;
  line-height: 1.45;
}

.summary-rate {
  margin: 6rpx 0;
  color: #10224A;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
}

.summary-side {
  display: flex;
  flex-basis: 150rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-left: 1rpx solid rgba(16, 34, 74, 0.09);
  background: #EEF5DD;
}

.summary-side-value {
  color: #10224A;
  font-size: 38rpx;
  font-weight: 800;
}

.summary-side-label {
  margin-top: 8rpx;
  color: #69725B;
  font-size: 20rpx;
}

.dashboard-list,
.focus-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin: 0 28rpx;
}

.analytics-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 18rpx;
  min-height: 108rpx;
  padding: 22rpx 24rpx;
}

.analytics-row-main,
.focus-main {
  flex: 1;
  min-width: 0;
}

.analytics-title,
.focus-name,
.grant-title {
  display: block;
  color: #10224A;
  font-size: 27rpx;
  font-weight: 750;
}

.analytics-score {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.analytics-rate {
  color: #2F6FAE;
  font-size: 30rpx;
  font-weight: 800;
}

.grade-subject-breakdown {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(16, 34, 74, 0.08);
}

.subject-stat {
  display: flex;
  justify-content: space-between;
  min-width: 0;
  padding: 12rpx 14rpx;
  color: #405274;
  font-size: 21rpx;
  background: #F6F3E8;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin: 0 28rpx;
}

.subject-metric {
  min-height: 138rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(16, 34, 74, 0.09);
  border-radius: 8rpx;
  background: #FFFDF6;
}

.subject-name,
.subject-rate,
.subject-meta {
  display: block;
}

.subject-name {
  color: #5B6781;
  font-size: 22rpx;
}

.subject-rate {
  margin: 8rpx 0 4rpx;
  color: #10224A;
  font-size: 36rpx;
  font-weight: 800;
}

.analytics-avatar {
  width: 52rpx;
  height: 52rpx;
  padding: 12rpx;
  background: #E8EEFF;
}

.focus-card {
  padding: 22rpx;
}

.focus-card.attention {
  border-left: 6rpx solid #D46A49;
}

.focus-card.excellent {
  border-left: 6rpx solid #6E9A61;
}

.focus-head,
.focus-stats,
.focus-note-row,
.excellent-toggle {
  display: flex;
  align-items: center;
}

.focus-head {
  gap: 16rpx;
}

.focus-avatar {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 56rpx;
  color: #8A3F2B;
  font-size: 24rpx;
  font-weight: 800;
  background: #FFE8DF;
}

.excellent-avatar {
  color: #416F36;
  background: #E4F1DA;
}

.focus-status {
  max-width: 170rpx;
  color: #A65238;
  font-size: 20rpx;
  line-height: 1.35;
  text-align: right;
}

.excellent .focus-status {
  color: #4F7D43;
  font-size: 26rpx;
  font-weight: 800;
}

.focus-stats {
  justify-content: space-between;
  margin: 18rpx 0 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(16, 34, 74, 0.08);
  color: #5B6781;
  font-size: 21rpx;
}

.focus-note-row {
  gap: 12rpx;
}

.focus-note-input {
  min-width: 0;
  height: 64rpx;
  flex: 1;
  padding: 0 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(16, 34, 74, 0.1);
  border-radius: 6rpx;
  color: #10224A;
  font-size: 22rpx;
  background: #FFFCF2;
}

.focus-save {
  width: 84rpx;
  height: 64rpx;
  padding: 0;
  border-radius: 6rpx;
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 750;
  line-height: 64rpx;
  background: #2F6FAE;
}

.excellent-toggle,
.grant-summary {
  margin: 18rpx 28rpx 0;
  padding: 22rpx;
  border-top: 1rpx solid rgba(16, 34, 74, 0.1);
  border-bottom: 1rpx solid rgba(16, 34, 74, 0.1);
  color: #10224A;
  font-size: 23rpx;
  font-weight: 700;
}

.excellent-toggle {
  justify-content: space-between;
}

.excellent-list {
  margin-top: 14rpx;
}

.grant-summary {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

@media (max-width: 340px) {
  .summary-side {
    flex-basis: 126rpx;
  }

  .focus-status {
    max-width: 136rpx;
  }
}
