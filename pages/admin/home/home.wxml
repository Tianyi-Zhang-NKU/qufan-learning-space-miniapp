<view class="qf-page qf-page-fixed admin-dashboard">
  <z-bg mode="dark"></z-bg>

  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="qf-scroll-body">
    <view class="qf-top">
      <view class="qf-brand">
        <text class="qf-brand-title">学习通关看板</text>
        <text class="qf-brand-sub">{{scope.isSuperAdmin ? '全机构数据' : '授权范围内的数据'}}</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="qf-empty"><text>正在汇总通关数据</text></view>

    <block wx:else>
      <view class="summary-strip">
        <view class="summary-main">
          <text class="summary-kicker">累计通关率</text>
          <text class="summary-rate">{{summary.passRateText}}</text>
          <text class="summary-meta">{{summary.confirmationText}} 次学生课次已确认</text>
        </view>
        <view class="summary-side">
          <text class="summary-side-value">{{summary.courseCount || 0}}</text>
          <text class="summary-side-label">在管课程</text>
        </view>
      </view>

      <view class="qf-section">年级通关率</view>
      <view wx:if="{{gradeStatistics.length}}" class="dashboard-list">
        <view wx:for="{{gradeStatistics}}" wx:key="grade" class="qf-card analytics-row" data-grade="{{item.grade}}" bindtap="toggleGrade">
          <view class="analytics-row-main">
            <text class="analytics-title">{{item.gradeName}}</text>
            <text class="analytics-meta">{{item.confirmationText}} 次学生课次已确认</text>
          </view>
          <view class="analytics-score">
            <text class="analytics-rate">{{item.passRateText}}</text>
            <image class="qf-inline-icon" src="{{expandedGrade === item.grade ? '/assets/icons/chevron-up.svg' : '/assets/icons/chevron-down.svg'}}" mode="aspectFit"></image>
          </view>
          <view wx:if="{{expandedGrade === item.grade}}" class="grade-subject-breakdown">
            <view wx:for="{{item.subjects}}" wx:for-item="subject" wx:key="subjectName" class="subject-stat">
              <text>{{subject.subjectName}}</text>
              <text>{{subject.passRateText}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="qf-empty compact">暂无已结束课次</view>

      <view class="qf-section">学科通关率</view>
      <view wx:if="{{subjectStatistics.length}}" class="metric-grid">
        <view wx:for="{{subjectStatistics}}" wx:key="subject" class="subject-metric">
          <text class="subject-name">{{item.subjectName}}</text>
          <text class="subject-rate">{{item.passRateText}}</text>
          <text class="subject-meta">{{item.confirmationText}}</text>
        </view>
      </view>
      <view wx:else class="qf-empty compact">暂无学科统计</view>

      <view class="qf-section">教师通关率</view>
      <view wx:if="{{teacherStatistics.length}}" class="dashboard-list">
        <view wx:for="{{teacherStatistics}}" wx:key="teacherId" class="qf-card analytics-row teacher-row">
          <image class="analytics-avatar" src="/assets/icons/teacher.svg" mode="aspectFit"></image>
          <view class="analytics-row-main">
            <text class="analytics-title">{{item.teacherName}}</text>
            <text class="analytics-meta">{{item.courseStatistics.length}} 门课程 · {{item.confirmationText}}</text>
          </view>
          <text class="analytics-rate">{{item.passRateText}}</text>
        </view>
      </view>
      <view wx:else class="qf-empty compact">暂无教师统计</view>

      <view class="qf-section">重点关注学员</view>
      <view wx:if="{{needsAttention.length}}" class="focus-list">
        <view wx:for="{{needsAttention}}" wx:key="id" class="qf-card focus-card attention">
          <view class="focus-head">
            <view class="focus-avatar">{{item.studentName[0]}}</view>
            <view class="focus-main">
              <text class="focus-name">{{item.studentName}}</text>
              <text class="focus-meta">{{item.courseName}} · {{item.teacherName}}</text>
            </view>
            <view class="focus-status">{{item.attentionText}}</view>
          </view>
          <view class="focus-stats">
            <text>通关率 {{item.passRateText}}</text>
            <text>{{item.confirmationText}}</text>
          </view>
          <view class="focus-note-row">
            <input class="focus-note-input" value="{{item.noteDraft}}" placeholder="填写跟进备注" data-id="{{item.id}}" bindinput="onNoteInput" />
            <button class="focus-save" data-id="{{item.id}}" bindtap="saveFocusNote" disabled="{{savingFocusId === item.id}}">保存</button>
          </view>
        </view>
      </view>
      <view wx:else class="qf-empty compact">暂无需要重点跟进的学员</view>

      <view class="excellent-toggle" wx:if="{{excellentStudents.length}}" bindtap="toggleExcellent">
        <text>表现优秀学员 {{excellentStudents.length}} 人</text>
        <image class="qf-inline-icon" src="{{showExcellent ? '/assets/icons/chevron-up.svg' : '/assets/icons/chevron-down.svg'}}" mode="aspectFit"></image>
      </view>
      <view wx:if="{{showExcellent}}" class="focus-list excellent-list">
        <view wx:for="{{excellentStudents}}" wx:key="id" class="qf-card focus-card excellent">
          <view class="focus-head">
            <view class="focus-avatar excellent-avatar">{{item.studentName[0]}}</view>
            <view class="focus-main">
              <text class="focus-name">{{item.studentName}}</text>
              <text class="focus-meta">{{item.courseName}} · {{item.teacherName}}</text>
            </view>
            <view class="focus-status">{{item.passRateText}}</view>
          </view>
          <view class="focus-note-row">
            <input class="focus-note-input" value="{{item.noteDraft}}" placeholder="填写鼓励或备注" data-id="{{item.id}}" bindinput="onNoteInput" />
            <button class="focus-save" data-id="{{item.id}}" bindtap="saveFocusNote" disabled="{{savingFocusId === item.id}}">保存</button>
          </view>
        </view>
      </view>

      <view wx:if="{{scope.isSuperAdmin && grants.length}}" class="grant-summary">
        <text class="grant-title">分级管理员授权</text>
        <text class="grant-meta">已配置 {{grants.length}} 个管理员身份；完整授权编辑将在教研后台统一维护。</text>
      </view>
    </block>
    <view class="qf-safe-bottom"></view>
  </scroll-view>

  <qf-role-tabbar role="admin" is-super-admin="{{scope.isSuperAdmin}}" current="/pages/admin/home/home" fixed="{{false}}"></qf-role-tabbar>
</view>
