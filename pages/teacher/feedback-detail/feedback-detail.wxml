<view class="qf-page qf-page-fixed">
  <z-bg mode="dark"></z-bg>

  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="qf-scroll-body">
    <view class="qf-top">
      <view class="qf-brand">
        <text class="qf-brand-title">{{studentName}} · 学习反馈</text>
        <text class="qf-brand-sub">{{courseName}} · 选择课次和反馈类型</text>
      </view>
    </view>

    <view class="pass-quick-card" wx:if="{{activeSessionId}}">
      <view class="pass-quick-copy">
        <text class="pass-quick-title">本讲通关确认</text>
        <text class="pass-quick-sub">确认后学生端进度、电子章和荣誉记录同步更新</text>
      </view>
      <button class="pass-quick-btn" bindtap="confirmPassNow" disabled="{{submitting}}">确认通关</button>
    </view>

    <view class="session-nav-wrapper">
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="session-nav-scroll">
        <view class="session-nav-inner">
          <view
            wx:for="{{sessions}}"
            wx:key="id"
            class="session-tab {{activeSessionId === item.id ? 'active' : ''}}"
            data-session-id="{{item.id}}"
            bindtap="selectSession"
          >
            <text class="session-tab-title">{{item.sessionTitle || item.displayTitle}}</text>
            <text class="session-tab-date">{{item.date}}</text>
            <view class="session-tab-status-dot {{item.status}}">{{item.statusText || '未开始'}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="qf-section">反馈类型</view>
    <view class="feedback-type-switch">
      <view
        wx:for="{{feedbackTypes}}"
        wx:key="value"
        class="type-pill {{feedbackType === item.value ? 'active' : ''}}"
        data-type="{{item.value}}"
        bindtap="selectFeedbackType"
      >{{item.label}}</view>
    </view>

    <view wx:if="{{existingFeedback}}" class="qf-card existing-feedback">
      <view class="existing-stamp passed" wx:if="{{feedbackType === 'general' && existingFeedback.passed}}">已通关</view>
      <view class="existing-stamp not-passed" wx:elif="{{feedbackType === 'general' && !existingFeedback.passed}}">暂未通关</view>
      <view class="existing-header">
        <text class="qf-h3">已有{{existingFeedback.feedbackTypeText}}</text>
        <text class="qf-muted">{{existingFeedback.createdAt}}</text>
      </view>
      <text class="existing-text">{{existingFeedback.text}}</text>
      <view wx:if="{{existingFeedback.imageCount || existingFeedback.videoCount || existingFeedback.voiceCount || existingFeedback.attachFileCount}}" class="existing-media-tags">
        <view wx:if="{{existingFeedback.imageCount}}" class="media-tag">图片 {{existingFeedback.imageCount}}</view>
        <view wx:if="{{existingFeedback.videoCount}}" class="media-tag">视频 {{existingFeedback.videoCount}}</view>
        <view wx:if="{{existingFeedback.voiceCount}}" class="media-tag">语音 {{existingFeedback.voiceCount}}</view>
        <view wx:if="{{existingFeedback.attachFileCount}}" class="media-tag">文档 {{existingFeedback.attachFileCount}}</view>
      </view>
    </view>

    <view class="qf-section">文字说明</view>
    <view class="qf-card tight">
      <textarea
        class="feedback-textarea"
        value="{{feedbackText}}"
        placeholder="记录错题原因、讲解重点、学生需要回看的位置等"
        placeholder-style="color: #9aada2;"
        maxlength="2000"
        auto-height
        bindinput="onTextInput"
      ></textarea>
      <view class="textarea-toolbar">
        <button class="emoji-btn" catchtap="toggleEmojiPanel">
          <text class="emoji-btn-icon">😊</text>
          <text class="emoji-btn-text">表情</text>
        </button>
        <view class="clear-text-btn" wx:if="{{feedbackText}}" catchtap="clearFeedbackText">×</view>
      </view>
      <view wx:if="{{showEmojiPanel}}" class="emoji-panel">
        <view
          wx:for="{{emojiList}}"
          wx:key="*this"
          class="emoji-item"
          data-emoji="{{item}}"
          catchtap="insertEmoji"
        >{{item}}</view>
      </view>
    </view>

    <view class="qf-section">图片 / 文档</view>
    <view class="qf-card tight">
      <view wx:if="{{imageFiles.length || docFiles.length}}" class="media-preview-list">
        <view wx:for="{{imageFiles}}" wx:key="id" class="media-preview-item">
          <image wx:if="{{item.tempPath}}" class="preview-thumb" src="{{item.tempPath}}" mode="aspectFill"></image>
          <view wx:else class="preview-thumb-placeholder">图</view>
          <text class="preview-name">{{item.name}}</text>
          <button class="remove-btn" data-id="{{item.id}}" data-type="image" bindtap="removeMedia">×</button>
        </view>
        <view wx:for="{{docFiles}}" wx:key="id" class="media-preview-item">
          <view class="preview-thumb doc-thumb">文档</view>
          <text class="preview-name">{{item.name}}</text>
          <button class="remove-btn" data-id="{{item.id}}" data-type="doc" bindtap="removeMedia">×</button>
        </view>
      </view>
      <view class="upload-btn-row">
        <button class="upload-btn flex-btn" bindtap="chooseImage">
          <image class="upload-btn-icon" src="/assets/icons/image.svg" mode="aspectFit"></image>
          <text>添加图片</text>
        </button>
        <button class="upload-btn flex-btn" bindtap="chooseDocument">
          <image class="upload-btn-icon" src="/assets/icons/note.svg" mode="aspectFit"></image>
          <text>上传文档</text>
        </button>
      </view>
    </view>

    <view class="qf-section">语音讲解</view>
    <view class="qf-card tight">
      <view wx:if="{{voiceFiles.length}}" class="voice-preview-list">
        <view wx:for="{{voiceFiles}}" wx:key="id" class="voice-preview-item">
          <view class="voice-mark">声</view>
          <view class="voice-info">
            <text class="voice-name">{{item.name}}</text>
            <text class="voice-meta">{{item.duration || 1}} 秒</text>
          </view>
          <button class="remove-btn inline-remove" data-id="{{item.id}}" data-type="voice" bindtap="removeMedia">×</button>
        </view>
      </view>
      <view class="record-actions">
        <button wx:if="{{!recording}}" class="upload-btn record-btn" bindtap="startRecord">
          <image class="upload-btn-icon" src="/assets/icons/voice.svg" mode="aspectFit"></image>
          <text>开始录音</text>
        </button>
        <button wx:else class="upload-btn record-btn recording" bindtap="stopRecord">
          <image class="upload-btn-icon" src="/assets/icons/stop.svg" mode="aspectFit"></image>
          <text>结束录音</text>
        </button>
      </view>
    </view>

    <view class="qf-section">学生错题勾选</view>
    <view class="qf-card tight wrong-question-card">
      <view wx:if="{{questionSlots.length}}" class="wrong-question-list">
        <view
          wx:for="{{questionSlots}}"
          wx:key="id"
          class="wrong-question-item {{item.checked ? 'checked' : ''}}"
          data-id="{{item.id}}"
          bindtap="toggleWrongQuestion"
        >
          <view class="wrong-check">{{item.checked ? '✓' : ''}}</view>
          <view class="wrong-question-main">
            <text class="wrong-question-title">{{item.order}}. {{item.title}}</text>
            <text class="wrong-question-file">{{item.file.name || '未上传资料'}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty-inline">本课次还没有题目框，请先到题目资料页上传。</view>
      <view class="wrong-metrics-row">
        <input class="wrong-metric-input" type="number" value="{{accuracyInput}}" placeholder="正确率%" bindinput="onAccuracyInput" />
        <input class="wrong-metric-input wide" value="{{rankTextInput}}" placeholder="班级位置，例如 超过班级40%同学" bindinput="onRankTextInput" />
      </view>
      <button class="wrong-save-btn" bindtap="saveWrongQuestions" disabled="{{savingWrongQuestions}}">{{savingWrongQuestions ? '保存中…' : '保存错题勾选'}}</button>
    </view>
    <view class="pass-toggle-area" wx:if="{{feedbackType === 'general'}}">
      <view class="qf-card tight pass-toggle-card">
        <view class="pass-toggle-row" bindtap="togglePass">
          <text class="pass-toggle-label">是否通关</text>
          <view class="pass-toggle-switch {{passed ? 'on' : ''}}">
            <view class="pass-toggle-knob"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="submit-area">
      <button class="qf-btn full submit-btn" bindtap="submitFeedback" disabled="{{submitting || recording}}">
        {{submitting ? '提交中…' : recording ? '录音中，请先结束' : '保存学习反馈'}}
      </button>
    </view>

    <view class="qf-safe-bottom"></view>
  </scroll-view>

  <qf-role-tabbar role="teacher" current="/pages/teacher/home/home" fixed="{{false}}"></qf-role-tabbar>
</view>
