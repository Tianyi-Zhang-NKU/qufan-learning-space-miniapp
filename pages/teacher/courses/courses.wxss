/* ===== Calendar Card ===== */
.calendar-card {
  position: relative;
  z-index: 1;
  margin-bottom: 32rpx;
  padding: 36rpx 30rpx 28rpx;
  border: 1rpx solid rgba(83, 117, 91, 0.22);
  border-radius: 34rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.7), rgba(255, 248, 232, 0.36)),
    rgba(255, 250, 238, 0.56);
  -webkit-backdrop-filter: blur(30rpx) saturate(1.16);
  backdrop-filter: blur(30rpx) saturate(1.16);
  box-shadow: 0 26rpx 76rpx rgba(74, 92, 68, 0.2);
}

/* Month header with nav arrows */
.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding: 0 8rpx;
}

.calendar-month {
  font-size: 34rpx;
  font-weight: 700;
  color: #173a32;
  font-family: "Noto Serif CJK SC", "Source Han Serif SC", "SimSun", "HarmonyOS Sans SC", serif;
}

.calendar-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.64);
  border: 1rpx solid rgba(83, 117, 91, 0.16);
  transition: background 120ms;
}

.calendar-nav:active {
  background: rgba(249, 115, 22, 0.12);
}

.calendar-nav-arrow {
  font-size: 38rpx;
  font-weight: 300;
  color: #173a32;
  line-height: 1;
  margin-top: -4rpx;
}

/* Weekday labels */
.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  margin-bottom: 12rpx;
}

.calendar-weekday {
  text-align: center;
  font-size: 23rpx;
  font-weight: 600;
  color: #65756b;
  padding: 10rpx 0;
}

/* Day grid */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6rpx;
}

.calendar-day {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 8rpx 0;
  border-radius: 18rpx;
  transition: background 120ms;
}

.calendar-day-num {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f352e;
  line-height: 1;
}

/* Today highlight */
.calendar-day.today .calendar-day-num {
  color: #f97316;
  font-weight: 700;
}

.calendar-day.today {
  background: rgba(249, 115, 22, 0.08);
}

/* Selected date */
.calendar-day.selected {
  background: #f97316;
  box-shadow: 0 8rpx 22rpx rgba(249, 115, 22, 0.28);
}

.calendar-day.selected .calendar-day-num {
  color: #fff9ec;
  font-weight: 700;
}

/* Other month (dimmed) */
.calendar-day.other-month .calendar-day-num {
  color: rgba(31, 53, 46, 0.22);
}

/* Course dot indicator */
.calendar-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #f97316;
}

.calendar-day.selected .calendar-dot {
  background: #fff9ec;
}

.calendar-day.other-month .calendar-dot {
  background: rgba(249, 115, 22, 0.3);
}

/* ===== Course Cards ===== */
.course-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.course-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(83, 117, 91, 0.18);
  border-radius: 28rpx;
  color: #1f352e;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.82), rgba(255, 250, 238, 0.48)),
    rgba(255, 250, 238, 0.68);
  box-shadow: 0 16rpx 44rpx rgba(74, 92, 68, 0.14);
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
}

.course-info {
  flex: 1;
  min-width: 0;
}

.course-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #173a32;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.course-topic {
  display: block;
  margin-bottom: 14rpx;
  color: #31405F;
  font-size: 23rpx;
  line-height: 1.4;
}

.course-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.course-meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: rgba(45, 75, 64, 0.72);
  line-height: 1.4;
}

.course-meta-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

/* ===== Action Buttons ===== */
.course-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.test-btn {
  min-width: 128rpx;
  font-size: 22rpx;
}

.pre-test {
  background: linear-gradient(145deg, #fb923c, #ea580c), #f97316;
  border-color: rgba(194, 65, 12, 0.26);
}

.post-test {
  background: linear-gradient(145deg, #4ade80, #16a34a), #22c55e;
  border-color: rgba(21, 128, 61, 0.26);
}

.feedback-btn-action {
  color: #fff9ec;
  background: linear-gradient(145deg, #6366f1, #4f46e5);
  border-color: rgba(79, 70, 229, 0.28);
}

.live-test {
  color: #fff9ec;
  background: linear-gradient(145deg, #4d71bc, #365fa8);
  border-color: rgba(54, 95, 168, 0.28);
}

.edit-session {
  color: #10224A;
  background: #F6F3E8;
  border-color: rgba(16, 34, 74, 0.08);
}

.session-editor-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  background: rgba(8, 13, 35, 0.46);
}

.session-editor {
  width: 100%;
  max-width: 690rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #FFFDF6;
  border: 1rpx solid rgba(16, 34, 74, 0.08);
  box-shadow: 0 28rpx 78rpx rgba(35, 39, 55, 0.2);
}

.session-editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.session-editor-title {
  color: #10224A;
  font-size: 31rpx;
  font-weight: 850;
}

.session-editor-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8A8D88;
  font-size: 34rpx;
  background: #F6F3E8;
}

.session-editor-field + .session-editor-field {
  margin-top: 18rpx;
}

.session-editor-label {
  display: block;
  margin-bottom: 8rpx;
  color: #8A8D88;
  font-size: 22rpx;
  font-weight: 700;
}

.session-editor-input {
  width: 100%;
  height: 78rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #10224A;
  font-size: 25rpx;
  background: #F6F3E8;
}

.session-editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.session-editor-cancel,
.session-editor-save {
  flex: 1;
  height: 78rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.session-editor-cancel {
  color: #10224A;
  background: #F6F3E8;
}

.session-editor-save {
  color: #FFFFFF;
  background: #2F6FAE;
}

/* Light paper schedule board */
.calendar-card {
  border-color: rgba(16, 34, 74, 0.08);
  border-radius: 28rpx;
  background: #FFFDF6;
  box-shadow: 0 18rpx 42rpx rgba(35, 39, 55, 0.1);
}

.calendar-month,
.calendar-nav-arrow,
.calendar-day-num,
.course-name {
  color: #10224A;
}

.calendar-nav {
  border-color: rgba(16, 34, 74, 0.08);
  background: #F6F3E8;
}

.calendar-weekday,
.course-meta-item {
  color: #8A8D88;
}

.calendar-day.today {
  background: #FFE8BF;
}

.calendar-day.today .calendar-day-num {
  color: #9A5B10;
}

.calendar-day.selected {
  background: #2F6FAE;
  box-shadow: 0 10rpx 22rpx rgba(47, 111, 174, 0.18);
}

.calendar-dot {
  background: #F59A23;
}

.course-card {
  align-items: stretch;
  border-color: rgba(16, 34, 74, 0.08);
  border-radius: 24rpx;
  background: #FFFDF6;
  box-shadow: 0 14rpx 34rpx rgba(35, 39, 55, 0.08);
}

.course-actions {
  justify-content: center;
}

.test-btn {
  min-width: 132rpx;
  color: #10224A;
  border-color: rgba(16, 34, 74, 0.08);
  background: #F6F3E8;
  box-shadow: none;
}

.pre-test {
  background: #FFE8BF;
}

.post-test {
  background: #EEF5DD;
}

.feedback-btn-action {
  color: #10224A;
  background: #EFEAFF;
}

.live-test {
  color: #10224A;
  background: #E8EEFF;
}

.edit-session {
  background: #FFFCF2;
}
