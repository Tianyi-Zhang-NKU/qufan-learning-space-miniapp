.login-page {
  box-sizing: border-box;
  min-height: 100vh;
  display: block;
  padding: 72rpx 36rpx 76rpx;
  overflow-y: auto;
  opacity: 1;
  animation: none;
  background:
    linear-gradient(180deg, rgba(255, 253, 246, 0.94), rgba(233, 230, 218, 0.98)),
    #E9E6DA;
}

.login-shell {
  position: relative;
  z-index: 20;
  width: 100%;
  max-width: 680rpx;
  min-height: 860rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-brand {
  text-align: center;
  color: #10224A;
}

.login-brand-mark {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(16, 34, 74, 0.08);
  border-radius: 30rpx;
  background:
    linear-gradient(145deg, rgba(255, 253, 246, 0.96), rgba(238, 245, 221, 0.82)),
    #FFFDF6;
  box-shadow: 0 18rpx 42rpx rgba(35, 39, 55, 0.1);
  letter-spacing: 0;
}

.login-brand-icon {
  width: 92rpx;
  height: 92rpx;
}

.login-title {
  display: block;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.12;
  color: #10224A;
}

.login-sub {
  display: block;
  margin-top: 16rpx;
  color: #8A8D88;
  font-size: 25rpx;
  line-height: 1.45;
}

.login-panel {
  margin-top: 44rpx;
  margin-bottom: 16rpx;
  padding: 36rpx 34rpx 34rpx;
  border: 1rpx solid rgba(16, 34, 74, 0.08);
  border-radius: 30rpx;
  color: #10224A;
  background: rgba(255, 253, 246, 0.94);
  box-shadow: 0 22rpx 56rpx rgba(35, 39, 55, 0.11);
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
}

.login-card-head {
  margin-bottom: 28rpx;
  text-align: left;
}

.login-card-title {
  display: block;
  color: #10224A;
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.2;
}

.login-card-sub {
  display: block;
  margin-top: 9rpx;
  color: #8A8D88;
  font-size: 22rpx;
  line-height: 1.35;
}

.login-input {
  height: 84rpx;
  padding: 0 22rpx;
  text-align: left;
  font-size: 31rpx;
  font-weight: 650;
  border-color: transparent;
  background: #F6F3E8;
}

.login-primary {
  margin-top: 26rpx;
  background: #2F6FAE;
  box-shadow: 0 16rpx 34rpx rgba(47, 111, 174, 0.2);
}

.login-helper {
  margin: 4rpx auto 0;
  max-width: 520rpx;
  text-align: center;
  color: rgba(138, 141, 136, 0.82);
  font-size: 20rpx;
  line-height: 1.45;
}

.login-quick {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 12rpx;
}

.quick-login-toggle {
  min-height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: rgba(138, 141, 136, 0.74);
  font-size: 19rpx;
  background: rgba(255, 253, 246, 0.46);
  border: 1rpx solid rgba(16, 34, 74, 0.08);
}

.quick-login-panel {
  width: 100%;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 253, 246, 0.9);
  border: 1rpx solid rgba(16, 34, 74, 0.08);
  box-shadow: 0 12rpx 28rpx rgba(35, 39, 55, 0.08);
}

.quick-login-account {
  width: 100%;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
  border-radius: 16rpx;
  color: #10224A;
  font-size: 22rpx;
  background: #F6F3E8;
}

.quick-login-account:first-child {
  margin-top: 0;
}
