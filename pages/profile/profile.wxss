/* ===== 通用身份头部 ===== */

/* Entry grid for parent tools */
.profile-entry-grid {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.profile-entry-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 12rpx;
}

.profile-identity-header {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

/* 头像 */
.avatar-wrapper {
  position: relative;
  margin-bottom: 20rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #f97316, #ea580c);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 42rpx rgba(249, 115, 22, 0.34);
  border: 4rpx solid rgba(255, 249, 236, 0.6);
}

.avatar-text {
  color: #fff9ec;
  font-size: 56rpx;
  font-weight: 700;
  font-family: "Noto Serif CJK SC", "Source Han Serif SC", serif;
}

.avatar-badge {
  position: absolute;
  bottom: -4rpx;
  right: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 34rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 600;
  color: #fff9ec;
  background: #22c55e;
  border: 3rpx solid rgba(255, 249, 236, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(34, 197, 94, 0.28);
}

.teacher-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #173a32;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.teacher-sub {
  display: block;
  font-size: 24rpx;
  color: #65756b;
  margin-bottom: 4rpx;
}

.teacher-phone {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #8a9d92;
}

/* ===== 数据概览 ===== */
.stats-grid {
  position: relative;
  z-index: 1;
  max-width: 660rpx;
  margin: 32rpx auto;
}

.stat-metric {
  text-align: center;
}

/* ===== 合集卡片 ===== */
.collection-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.collection-card {
  cursor: pointer;
}

.collection-card:active {
  background: rgba(249, 115, 22, 0.04);
}

.collection-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.collection-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.course-icon {
  background: rgba(249, 115, 22, 0.12);
}

.student-icon {
  background: rgba(99, 102, 241, 0.12);
}

.collection-info {
  flex: 1;
  min-width: 0;
}

.collection-name {
  display: block;
  font-size: 27rpx;
  font-weight: 650;
  color: #173a32;
  line-height: 1.3;
}

.collection-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #65756b;
  line-height: 1.4;
}

.collection-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #b5c4b8;
  font-weight: 300;
}

/* ===== 通用：共享样式 ===== */
.profile-card,
.collection-list {
  max-width: 660rpx;
  margin-left: auto;
  margin-right: auto;
}

.profile-logout {
  position: relative;
  z-index: 1;
  max-width: 660rpx;
  margin: 44rpx auto 0;
}

.identity-switch-list {
  display: flex;
  flex-direction: column;
  padding: 0;
  overflow: hidden;
}

.identity-switch-row {
  width: 100%;
  min-height: 100rpx;
  margin: 0;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border: 0;
  border-top: 1rpx solid rgba(16, 34, 74, 0.08);
  border-radius: 0;
  text-align: left;
  background: #FFFDF6;
}

.identity-switch-row:first-child {
  border-top: 0;
}

.identity-switch-row.active {
  background: #E8EEFF;
}

.identity-switch-title,
.identity-switch-sub,
.identity-switch-state {
  display: block;
}

.identity-switch-title {
  color: #10224A;
  font-size: 25rpx;
  font-weight: 700;
}

.identity-switch-sub {
  margin-top: 4rpx;
  color: #69758B;
  font-size: 21rpx;
}

.identity-switch-state {
  flex-shrink: 0;
  color: #2F6FAE;
  font-size: 22rpx;
}

/* Light paper management overrides */
.avatar {
  color: #10224A;
  background: #E8EEFF;
  box-shadow: 0 16rpx 36rpx rgba(35, 39, 55, 0.1);
  border-color: #FFFDF6;
}

.avatar-text {
  color: #10224A;
}

.avatar-badge {
  color: #3E8B68;
  background: #EEF5DD;
  border-color: #FFFDF6;
}

.teacher-name,
.collection-name {
  color: #10224A;
}

.teacher-sub,
.teacher-phone,
.collection-meta,
.collection-arrow {
  color: #8A8D88;
}

.course-icon {
  background: #E8EEFF;
}

.student-icon {
  background: #EEF5DD;
}
